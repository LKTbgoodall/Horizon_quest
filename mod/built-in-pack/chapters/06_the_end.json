      "shape": "diamond",
      "optional": true,
      "dependencies": ["pearls"],
      "tasks": [
        { "id": "bow", "type": "item", "item": "minecraft:bow" },
        { "id": "arrows", "type": "item", "item": "minecraft:arrow", "count": 64 }
