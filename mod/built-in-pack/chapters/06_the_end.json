      "icon": "minecraft:end_crystal",
      "x": 2.5, "y": 6,
      "shape": "diamond",
      "optional": true,
      "dependencies": ["dragon_breath"],
      "tasks": [
        { "id": "end_crystal", "type": "item", "item": "minecraft:end_crystal", "count": 4 },
        { "id": "ender_dragon", "type": "kill", "entity": "minecraft:ender_dragon" }
      ],
      "rewards": [ { "id": "levels", "type": "xp_levels", "levels": 10 } ]
