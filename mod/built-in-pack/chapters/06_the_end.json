{
  "id": "the_end",
  "title": "The End",
  "subtitle": "The last dimension",
  "icon": "minecraft:end_stone",
  "group": "main",
  "quests": [
    {
      "id": "pearls",
      "title": "Ender pearls",
      "description": [
        "Endermen drop pearls. Do not look them in the eye unless you are ready for a fight. Twelve should be plenty."
