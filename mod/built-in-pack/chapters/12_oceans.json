      "rewards": [ { "id": "dried_kelp_block", "type": "item", "item": "minecraft:dried_kelp_block", "count": 4 } ]
    },
    {
      "id": "fish_bucket",
      "title": "Fish in a bucket",
      "description": [
        "Warm oceans are full of coloured fish. Catch one alive in a water bucket."
