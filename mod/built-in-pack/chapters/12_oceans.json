      "x": 8, "y": -1.5,
      "dependencies": ["treasure"],
      "tasks": [
        { "id": "nautilus_shell", "type": "item", "item": "minecraft:nautilus_shell", "count": 8 },
        { "id": "conduit", "type": "item", "item": "minecraft:conduit" }
