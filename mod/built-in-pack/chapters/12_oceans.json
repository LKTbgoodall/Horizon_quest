      "tasks": [ { "id": "check", "type": "checkmark", "title": "I looted a shipwreck" } ],
      "rewards": [ { "id": "emerald", "type": "item", "item": "minecraft:emerald", "count": 3 } ]
    },
    {
      "id": "treasure",
      "title": "X marks the spot",
      "description": [
