      ],
      "x": 6, "y": -1.5,
      "dependencies": ["shipwreck"],
      "tasks": [ { "id": "heart_of_the_sea", "type": "item", "item": "minecraft:heart_of_the_sea" } ],
      "rewards": [ { "id": "diamond", "type": "item", "item": "minecraft:diamond", "count": 2 } ]
