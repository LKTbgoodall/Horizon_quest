      "x": 2, "y": -1.5,
      "dependencies": ["good_catch"],
      "tasks": [ { "id": "tropical_fish_bucket", "type": "item", "item": "minecraft:tropical_fish_bucket" } ],
      "rewards": [ { "id": "bucket", "type": "item", "item": "minecraft:bucket" } ]
    },
    {
      "id": "turtles",
      "title": "Turtle power",
      "description": [
